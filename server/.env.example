# See README "Environments" for the canonical URLs per env.
# Local dev: ngrok domain is `ea.ngrok.dev` — run `ngrok http --url=ea.ngrok.dev 80`.
# Staging:   API at https://api.ea.getsayla.com, frontend at https://ea.getsayla.com.

# Optional web SPA origin allowlist. Account connection pages live on the API.
# Local:   http://localhost:3000
# Staging: https://ea.getsayla.com
CLIENT_URL=

# Public API origin for account connection links and default OAuth callbacks.
# On Render this defaults to the platform-provided RENDER_EXTERNAL_URL.
# Elsewhere set it explicitly, e.g. https://your-api.example.com.
PUBLIC_API_URL=

DATABASE_URL=

GEMINI_API_KEY=

# Select one provider. Only that provider's credentials are required.
MESSAGING_PROVIDER=sendblue

# Linq iMessage gateway. Use webhook version 2026-02-03; see docs/linq.md.
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=

# SendBlue iMessage gateway. Webhook base URL is what SendBlue POSTs to.
# Local:   https://ea.ngrok.dev
# Staging: https://api.ea.getsayla.com
SENDBLUE_API_KEY=
SENDBLUE_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_BASE_URL=
SENDBLUE_WEBHOOK_SECRET=

# Optional Google account connection. Register the callback in Google Cloud.
# Leaving GOOGLE_REDIRECT_URI empty uses <public API origin>/api/auth/google/callback.
# Local:   https://ea.ngrok.dev/api/auth/google/callback
# Staging: https://api.ea.getsayla.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional Microsoft account connection. Register the callback in Microsoft Entra.
# Leaving MICROSOFT_REDIRECT_URI empty uses <public API origin>/api/auth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Google Places API (New) — server-side key for restaurant search.
# Enable "Places API (New)" in Google Cloud Console (separate from OAuth).
# No per-user auth required — this is a server-side key.
GOOGLE_MAPS_API_KEY=

# Optional single-owner lock. Leave empty in local to accept any inbound number.
OWNER_PHONE_NUMBER=

JWT_SECRET=
